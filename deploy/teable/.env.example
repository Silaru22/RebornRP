# Start with the same release that produced Reborn Base.tea.
# Upgrade only after the imported base has been verified and backed up.
TEABLE_IMAGE=ghcr.io/teableio/teable:release.2026-07-06T02-39-43Z.2116
TEABLE_BIND_ADDRESS=0.0.0.0
TEABLE_PORT=3000
PUBLIC_ORIGIN=http://192.168.1.100:3000

POSTGRES_HOST=teable-db
POSTGRES_PORT=5432
POSTGRES_DB=teable
POSTGRES_USER=teable
POSTGRES_PASSWORD=replace-with-a-long-random-password

REDIS_HOST=teable-cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-a-long-random-password

SECRET_KEY=replace-with-a-long-random-secret
PRISMA_DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
BACKEND_CACHE_PROVIDER=redis
BACKEND_CACHE_REDIS_URI=redis://default:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}
